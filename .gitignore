# 依赖与缓存
__pycache__/
*.py[cod]
.env
.venv/
venv/

# Node 依赖不入库;package.json/package-lock.json 需入库(CI npm ci 装精确版本)
node_modules/

# HTML 产物(CI 部署到 Pages,不入库;本地生成仅供预览)
public/

# 当天原始抓取缓存(REFRESH=1 可强制重抓)
.cache/

# 历史产物与调试转储(docx 已从流水线移除;bash 崩溃转储)
*.docx
*.stackdump

# 视觉伴侣草稿(本地 brainstorm 用)
.superpowers/
