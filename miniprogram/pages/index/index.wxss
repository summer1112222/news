.masthead {
  padding: 22px 16px 14px;
  border-bottom: 3px double var(--accent);
}
.masthead-title {
  font-family: var(--serif);
  font-size: 25px;
  font-weight: 700;
  letter-spacing: 1px;
  line-height: 1.2;
}
.masthead-meta {
  margin-top: 7px;
  font-family: var(--serif);
  font-size: 12.5px;
  color: var(--ink-2);
}
.history-link {
  display: inline;
  color: var(--accent);
  text-decoration: underline;
  text-underline-offset: 3px;
}
.regions {
  display: flex;
  margin-top: 14px;
  border: 1px solid var(--rule);
  border-radius: 7px;
  overflow: hidden;
}
.region {
  flex: 1;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 15px;
  color: var(--ink-2);
  letter-spacing: 2px;
  border-right: 1px solid var(--rule);
}
.region:last-child {
  border-right: 0;
}
.region.active {
  background: var(--accent);
  color: #fff;
  font-weight: 600;
}
.cats {
  position: sticky;
  top: 0;
  z-index: 10;
  white-space: nowrap;
  background: var(--bg);
  border-bottom: 1px solid var(--rule);
}
.cat {
  display: inline-block;
  padding: 12px 13px;
  font-size: 14px;
  color: var(--ink-2);
  border-bottom: 2px solid transparent;
}
.cat.active {
  color: var(--ink);
  border-bottom-color: var(--accent);
  font-weight: 600;
}
.body {
  padding: 6px 16px calc(30px + env(safe-area-inset-bottom));
}
.panel-head {
  display: flex;
  align-items: baseline;
  gap: 12px;
  margin: 20px 0 2px;
}
.panel-title {
  font-family: var(--serif);
  font-size: 19px;
  font-weight: 700;
  padding-left: 10px;
  border-left: 3px solid var(--accent);
}
.panel-count {
  font-family: var(--serif);
  font-size: 12px;
  color: var(--ink-2);
}
.footer {
  padding: 22px 16px calc(30px + env(safe-area-inset-bottom));
  font-family: var(--serif);
  font-size: 12px;
  color: var(--ink-2);
  border-top: 1px solid var(--rule);
  text-align: center;
}
