.day-list {
  padding: 8px 16px;
}
.day-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 14px 0;
  border-bottom: 1px solid var(--rule);
}
.day-date {
  font-family: var(--serif);
  font-size: 17px;
  font-weight: 600;
  color: var(--ink);
}
.day-total {
  font-family: var(--serif);
  font-size: 12px;
  color: var(--ink-2);
}
.empty {
  padding: 18px 0;
  font-family: var(--serif);
  font-size: 14px;
  color: var(--ink-2);
}
.day-head {
  display: flex;
  align-items: baseline;
  gap: 12px;
  padding: 16px 16px 10px;
  border-bottom: 3px double var(--accent);
}
.back {
  font-size: 14px;
  color: var(--accent);
}
.day-title {
  font-family: var(--serif);
  font-size: 20px;
  font-weight: 700;
}
.regions {
  display: flex;
  margin: 14px 16px 0;
  border: 1px solid var(--rule);
  border-radius: 7px;
  overflow: hidden;
}
.region {
  flex: 1;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 15px;
  color: var(--ink-2);
  letter-spacing: 2px;
  border-right: 1px solid var(--rule);
}
.region:last-child {
  border-right: 0;
}
.region.active {
  background: var(--accent);
  color: #fff;
  font-weight: 600;
}
.cats {
  margin-top: 12px;
  white-space: nowrap;
  background: var(--bg);
  border-bottom: 1px solid var(--rule);
}
.cat {
  display: inline-block;
  padding: 12px 13px;
  font-size: 14px;
  color: var(--ink-2);
  border-bottom: 2px solid transparent;
}
.cat.active {
  color: var(--ink);
  border-bottom-color: var(--accent);
  font-weight: 600;
}
.body {
  padding: 6px 16px calc(30px + env(safe-area-inset-bottom));
}
.panel-head {
  display: flex;
  align-items: baseline;
  gap: 12px;
  margin: 20px 0 2px;
}
.panel-title {
  font-family: var(--serif);
  font-size: 19px;
  font-weight: 700;
  padding-left: 10px;
  border-left: 3px solid var(--accent);
}
.panel-count {
  font-family: var(--serif);
  font-size: 12px;
  color: var(--ink-2);
}
